{
  "name": "dsh-bili-jar",
  "version": "0.2.3",
  "description": "DSH 插件：电子榨菜罐 —— 按你的兴趣轴定向挑 B站 视频的常驻小挂件",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "bilibili",
    "recommend"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "assets",
    "README.md",
    "NOTICE",
    "docs/publish.md",
    "docs/presets.md"
  ],
  "engines": {
    "dsh": ">=0.1.7-rc.1",
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "author": "Debuger-114514",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Debuger-114514/dsh-bili-jar.git"
  },
  "homepage": "https://github.com/Debuger-114514/dsh-bili-jar#readme",
  "bugs": {
    "url": "https://github.com/Debuger-114514/dsh-bili-jar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tools/config-check.mjs",
    "check": "node tools/pack-check.mjs",
    "prepublishOnly": "node tools/pack-check.mjs",
    "release": "npm version patch && git push --follow-tags"
  }
}
